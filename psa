        }

        // Định dạng tiền tệ theo chế độ đang chọn (JPY hoặc VND)
        function formatMoney(jpyAmount, forceCurrency = null) {
            const mode = forceCurrency || appState.currencyMode;
            const num = Number(jpyAmount) || 0;
            if (mode === 'VND') {
                const vnd = Math.round(num * appState.exchangeRate);
                return vnd.toLocaleString('vi-VN') + '₫';
            }
            return '¥' + Math.round(num).toLocaleString('en-US');
        }

        // Chuyển đổi hiển thị JPY <-> VND trên Header
        function toggleCurrencyDisplay() {
            appState.currencyMode = appState.currencyMode === 'JPY' ? 'VND' : 'JPY';
            saveData();
            renderAll();
            showToast(`Đang hiển thị theo ${appState.currencyMode === 'JPY' ? 'Yên Nhật (¥)' : 'Tiền Việt (₫)'}`);
        }

        // Cập nhật tỷ giá
        function updateExchangeRate(val) {
            const rate = parseFloat(val);
            if (rate && rate > 0) {
                appState.exchangeRate = rate;
                saveData();
                renderAll();
                convertQuickCurrency('JPY');
                showToast(`Đã cập nhật tỷ giá: 1¥ = ${rate}₫`);
            }
        }

        // Công cụ quy đổi nhanh
        function convertQuickCurrency(source) {
            const jpyInput = document.getElementById('quickJpyInput');
            const vndInput = document.getElementById('quickVndInput');
            const rate = appState.exchangeRate || 168;

            if (source === 'JPY') {
                const jpy = parseFloat(jpyInput.value);
                vndInput.value = !isNaN(jpy) ? Math.round(jpy * rate) : '';
            } else {
                const vnd = parseFloat(vndInput.value);
                jpyInput.value = !isNaN(vnd) ? Math.round(vnd / rate) : '';
            }
        }

        // Chuyển đổi giữa 3 Tab chính
        function switchTab(tabName) {
            const tabs = ['cards', 'batches', 'settings'];
            const titles = {
                cards: 'Danh Sách Thẻ',
                batches: 'Chi Phí & Lô Gửi',
                settings: 'Sao Lưu & Cài Đặt'
            };

            tabs.forEach(t => {
                const section = document.getElementById(`tab-${t}`);
                const navBtn = document.getElementById(`nav-${t}`);
                if (t === tabName) {
                    section.classList.remove('hidden');
                    navBtn.classList.remove('text-gray-400');
                    navBtn.classList.add('text-ios-blue');
                } else {
                    section.classList.add('hidden');
                    navBtn.classList.remove('text-ios-blue');
                    navBtn.classList.add('text-gray-400');
                }
            });

            document.getElementById('headerTitle').textContent = titles[tabName];
            if (tabName === 'batches') renderBatches();
            if (tabName === 'settings') updateSampleBadge();
        }

        // Render toàn bộ giao diện
        function renderAll() {
            document.getElementById('headerRateDisplay').textContent = appState.exchangeRate;
            document.getElementById('exchangeRateInput').value = appState.exchangeRate;
            document.getElementById('currencyToggleBtn').textContent = appState.currencyMode === 'JPY' ? '¥ JPY' : '₫ VNĐ';
            const webhookInput = document.getElementById('gsWebhookInput');
            if (webhookInput) webhookInput.value = appState.gsWebhookUrl || '';

            populateBatchDropdowns();
            renderCards();
            renderBatches();
            updateSampleBadge();
        }

        // Đổ danh sách đợt gửi vào các thẻ <select>
        function populateBatchDropdowns() {
            const filterSelect = document.getElementById('batchFilterSelect');
            const cardBatchSelect = document.getElementById('cardBatchId');

            let filterHtml = `<option value="ALL">📦 Tất cả đợt gửi (${appState.batches.length})</option>`;
            let modalHtml = `<option value="">-- Không thuộc đợt nào --</option>`;

            appState.batches.forEach(b => {
                filterHtml += `<option value="${b.id}">📦 ${escapeHtml(b.name)}</option>`;
                modalHtml += `<option value="${b.id}">${escapeHtml(b.name)}</option>`;
            });

            filterSelect.innerHTML = filterHtml;
            filterSelect.value = appState.selectedBatch || 'ALL';
            cardBatchSelect.innerHTML = modalHtml;
        }

        function handleBatchChange(val) {
            appState.selectedBatch = val;
            saveData();
            renderCards();
        }

        // Tính chi phí phụ phí chia đều trên mỗi thẻ cho từng đợt gửi
        function getBatchOverheadPerCardMap() {
            const map = {};
            appState.batches.forEach(batch => {
                const cardsInBatch = appState.cards.filter(c => c.batchId === batch.id);
                const totalQty = cardsInBatch.reduce((sum, c) => sum + (Number(c.qty) || 1), 0);
                const totalOverhead = (Number(batch.shippingFee) || 0) + (Number(batch.extraFee) || 0);
                map[batch.id] = totalQty > 0 ? (totalOverhead / totalQty) : 0;
            });
            return map;
        }

        // Render Dashboard & Danh sách thẻ
        function renderCards() {
            const searchQuery = document.getElementById('searchInput').value.trim().toLowerCase();
            const statusFilter = document.getElementById('statusFilterSelect').value;
            const tcgFilter = document.getElementById('tcgFilterSelect').value;
            const batchFilter = appState.selectedBatch || 'ALL';

            // Hiện/ẩn nút xóa tìm kiếm & xóa lọc
            document.getElementById('clearSearchBtn').classList.toggle('hidden', searchQuery === '');
            const isFiltered = statusFilter !== 'ALL' || tcgFilter !== 'ALL' || searchQuery !== '';
            document.getElementById('resetFilterBtn').classList.toggle('hidden', !isFiltered);

            // Lọc theo đợt gửi trước để tính Dashboard cho đợt đó (hoặc toàn bộ)
            const batchCards = appState.cards.filter(c => batchFilter === 'ALL' || c.batchId === batchFilter);
            const overheadMap = getBatchOverheadPerCardMap();

            // Tính toán số liệu Dashboard
            let totalCardsCount = 0;
            let completedCardsCount = 0;
            let totalCostJpy = 0;
            let totalRevenueJpy = 0;

            let cntPrep = 0, cntShip = 0, cntGrad = 0, cntDone = 0;

            batchCards.forEach(c => {
                const qty = Number(c.qty) || 1;
                const psaCost = Number(c.psaCost) || 0;
                const revPrice = Number(c.customerPrice) || 0;
                const overheadPerCard = c.batchId ? (overheadMap[c.batchId] || 0) : 0;

                totalCardsCount += qty;
                totalCostJpy += (psaCost + overheadPerCard) * qty;
                totalRevenueJpy += revPrice * qty;

                if (c.status === 'preparing') cntPrep += qty;
                else if (c.status === 'shipped') cntShip += qty;
                else if (c.status === 'grading') cntGrad += qty;
                else if (c.status === 'graded' || c.status === 'returned') {
                    cntDone += qty;
                    completedCardsCount += qty;
                }
            });

            // Nếu đang xem 1 đợt cụ thể mà đợt đó chưa có thẻ nào, vẫn cộng phí ship cố định của đợt nếu có
            if (batchFilter !== 'ALL' && batchCards.length === 0) {
                const b = appState.batches.find(x => x.id === batchFilter);
                if (b) totalCostJpy += (Number(b.shippingFee) || 0) + (Number(b.extraFee) || 0);
            }

            const netProfitJpy = totalRevenueJpy - totalCostJpy;
            const secondaryCurrency = appState.currencyMode === 'JPY' ? 'VND' : 'JPY';

            document.getElementById('statTotalCards').textContent = totalCardsCount;
            document.getElementById('statCompletedCards').textContent = completedCardsCount;
            
            const profitEl = document.getElementById('statNetProfit');
            profitEl.textContent = (netProfitJpy >= 0 ? '+' : '') + formatMoney(netProfitJpy);
            profitEl.className = `text-xl font-extrabold mt-0.5 ${netProfitJpy >= 0 ? 'text-ios-green' : 'text-psa-red'}`;
            document.getElementById('statNetProfitSub').textContent = (netProfitJpy >= 0 ? '+' : '') + formatMoney(netProfitJpy, secondaryCurrency);

            document.getElementById('statTotalCost').textContent = formatMoney(totalCostJpy);
            document.getElementById('statTotalCostSub').textContent = formatMoney(totalCostJpy, secondaryCurrency);

            document.getElementById('statTotalRevenue').textContent = formatMoney(totalRevenueJpy);
            document.getElementById('statTotalRevenueSub').textContent = formatMoney(totalRevenueJpy, secondaryCurrency);

            document.getElementById('countPreparing').textContent = cntPrep;
            document.getElementById('countShipped').textContent = cntShip;
            document.getElementById('countGrading').textContent = cntGrad;
            document.getElementById('countDone').textContent = cntDone;

            // Lọc danh sách hiển thị theo tìm kiếm, trạng thái và hệ thẻ
            const filteredCards = batchCards.filter(c => {
                const matchSearch = !searchQuery || 
                    c.name.toLowerCase().includes(searchQuery) ||
                    (c.code && c.code.toLowerCase().includes(searchQuery)) ||
                    (c.customer && c.customer.toLowerCase().includes(searchQuery)) ||
                    (c.cert && c.cert.toLowerCase().includes(searchQuery));
                
                const matchStatus = statusFilter === 'ALL' || 
                    (statusFilter === 'done' ? (c.status === 'graded' || c.status === 'returned') : c.status === statusFilter);
                
                const matchTcg = tcgFilter === 'ALL' || c.tcg === tcgFilter;

                return matchSearch && matchStatus && matchTcg;
            });

            const container = document.getElementById('cardsListContainer');
            if (filteredCards.length === 0) {
                container.innerHTML = `
                    <div class="bg-white rounded-2xl p-8 text-center shadow-sm border border-gray-100">
                        <div class="w-12 h-12 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mx-auto mb-3 text-xl">
                            <i class="fa-regular fa-folder-open"></i>
                        </div>
                        <p class="text-sm font-bold text-gray-800">Không tìm thấy thẻ nào</p>
                        <p class="text-xs text-gray-500 mt-1">Nhấn nút <strong>+</strong> ở góc trên để thêm thẻ gửi chấm mới.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filteredCards.map(card => {
                const statusBadge = getStatusBadgeHtml(card.status);
                const qty = Number(card.qty) || 1;
                const overhead = card.batchId ? (overheadMap[card.batchId] || 0) : 0;
                const totalItemCost = ((Number(card.psaCost) || 0) + overhead) * qty;
                const totalItemRev = (Number(card.customerPrice) || 0) * qty;
                const itemProfit = totalItemRev - totalItemCost;
                const isPersonal = !card.customer || card.customer.trim().toLowerCase() === 'cá nhân';

                return `
                    <div onclick="openCardModal('${card.id}')" class="bg-white rounded-2xl p-3.5 shadow-sm border border-gray-100 active:scale-[0.99] transition cursor-pointer space-y-2.5">
                        <!-- Dòng 1: Tên thẻ & Trạng thái -->
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-100 text-gray-600">${escapeHtml(card.tcg)}</span>
                                    ${card.code ? `<span class="text-[11px] font-mono font-semibold text-gray-500">${escapeHtml(card.code)}</span>` : ''}
                                    ${qty > 1 ? `<span class="text-[11px] font-extrabold text-ios-blue bg-blue-50 px-1.5 py-0.5 rounded-md">x${qty}</span>` : ''}
                                </div>
                                <h3 class="text-sm font-bold text-gray-900 mt-1 leading-snug">${escapeHtml(card.name)}</h3>
                            </div>
                            <div class="flex-shrink-0">
                                ${statusBadge}
                            </div>
                        </div>

                        <!-- Dòng 2: Khách hàng, Gói dịch vụ & Điểm PSA -->
                        <div class="flex items-center justify-between text-xs text-gray-600 bg-gray-50/80 rounded-xl px-2.5 py-2">
                            <div class="flex items-center gap-2 truncate">
                                <span class="font-semibold ${isPersonal ? 'text-gray-500' : 'text-gray-800'}">
                                    <i class="fa-solid ${isPersonal ? 'fa-user' : 'fa-user-tag'} text-[10px] mr-1 text-gray-400"></i>${escapeHtml(card.customer || 'Cá nhân')}
                                </span>
                                <span class="text-gray-300">•</span>
                                <span class="text-gray-500">${escapeHtml(card.serviceTier)}</span>
                            </div>
                            <div class="font-extrabold ${card.grade === 'PSA 10' ? 'text-psa-red' : 'text-gray-700'} flex-shrink-0">
                                ${escapeHtml(card.grade)}
                            </div>
                        </div>

                        <!-- Dòng 3: Chi phí & Lợi nhuận -->
                        <div class="flex items-center justify-between pt-0.5 text-xs">
                            <div class="text-gray-500">
                                Phí PSA: <span class="font-bold text-gray-800">${formatMoney(totalItemCost)}</span>
                                ${!isPersonal ? `<span class="mx-1 text-gray-300">|</span> Thu: <span class="font-bold text-ios-blue">${formatMoney(totalItemRev)}</span>` : ''}
                            </div>
                            <div>
                                ${isPersonal 
                                    ? `<span class="text-[11px] font-medium text-gray-400 italic">Thẻ tự gửi</span>`
                                    : `<span class="font-extrabold ${itemProfit >= 0 ? 'text-ios-green' : 'text-psa-red'}">${itemProfit >= 0 ? '+' : ''}${formatMoney(itemProfit)}</span>`
                                }
                            </div>
                        </div>

                        ${card.notes ? `<p class="text-[11px] text-gray-400 truncate border-t border-gray-100 pt-1.5"><i class="fa-regular fa-note-sticky mr-1"></i>${escapeHtml(card.notes)}</p>` : ''}
                    </div>
                `;
            }).join('');
        }

        function getStatusBadgeHtml(status) {
            const map = {
                preparing: { text: 'Chuẩn bị', cls: 'bg-amber-100 text-amber-800' },
                shipped: { text: 'Đã gửi PSA', cls: 'bg-blue-100 text-blue-800' },
                grading: { text: 'Đang chấm', cls: 'bg-purple-100 text-purple-800' },
                graded: { text: 'Đã có điểm', cls: 'bg-emerald-100 text-emerald-800' },
                returned: { text: 'Đã trả khách', cls: 'bg-gray-200 text-gray-700' }
            };
            const s = map[status] || map.preparing;
            return `<span class="text-[11px] font-bold px-2.5 py-1 rounded-full ${s.cls}">${s.text}</span>`;
        }

        // Lọc nhanh khi bấm vào 4 ô trạng thái trên Dashboard
        function quickFilterStatus(statusKey) {
            const select = document.getElementById('statusFilterSelect');
            select.value = select.value === statusKey ? 'ALL' : statusKey;
            renderCards();
