            }
            const editId = document.getElementById('editBatchId').value;
            const batchObj = {
                id: editId || 'batch_' + Date.now(),
                name: name,
                shippingFee: Math.max(0, parseFloat(document.getElementById('batchShipping').value) || 0),
                extraFee: Math.max(0, parseFloat(document.getElementById('batchExtraFee').value) || 0)
            };

            if (editId) {
                const idx = appState.batches.findIndex(b => b.id === editId);
                if (idx !== -1) appState.batches[idx] = batchObj;
                showToast("Đã cập nhật đợt gửi");
            } else {
                appState.batches.unshift(batchObj);
                showToast("Đã tạo đợt gửi mới");
            }

            saveData();
            closeBatchModal();
            renderAll();
        }

        function deleteCurrentBatch() {
            const editId = document.getElementById('editBatchId').value;
            if (!editId) return;
            openConfirmDialog("Xóa đợt gửi này?", "Các thẻ thuộc đợt này sẽ được giữ lại nhưng không gắn với đợt nào.", () => {
                appState.batches = appState.batches.filter(b => b.id !== editId);
                appState.cards.forEach(c => { if (c.batchId === editId) c.batchId = ''; });
                if (appState.selectedBatch === editId) appState.selectedBatch = 'ALL';
                saveData();
                closeBatchModal();
                renderAll();
                showToast("Đã xóa đợt gửi");
            });
        }

        // ================= SAO LƯU & XUẤT / NHẬP DỮ LIỆU =================
        function updateSampleBadge() {
            const sampleCount = appState.cards.filter(c => c.isSample).length;
            document.getElementById('sampleCountBadge').textContent = `${sampleCount} mẫu`;
        }

        function removeSampleData() {
            const sampleCount = appState.cards.filter(c => c.isSample).length;
            if (sampleCount === 0) {
                showToast("Không còn thẻ dữ liệu mẫu nào!");
                return;
            }
            openConfirmDialog("Xóa dữ liệu mẫu?", `Xóa ${sampleCount} thẻ mẫu mặc định khỏi danh sách?`, () => {
                appState.cards = appState.cards.filter(c => !c.isSample);
                saveData();
                renderAll();
                showToast("Đã xóa toàn bộ thẻ mẫu");
            });
        }

        function confirmResetAll() {
            openConfirmDialog("Xóa toàn bộ dữ liệu?", "Toàn bộ danh sách thẻ và đợt gửi sẽ bị xóa vĩnh viễn.", () => {
                appState.cards = [];
                appState.batches = [];
                appState.selectedBatch = 'ALL';
                saveData();
                renderAll();
                showToast("Đã đặt lại ứng dụng trống");
            });
        }

        function exportJSON() {
            const dataStr = JSON.stringify(appState, null, 2);
            const blob = new Blob([dataStr], { type: "application/json" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            const dateStr = new Date().toISOString().slice(0, 10);
            a.href = url;
            a.download = `PSA_Tracker_Backup_${dateStr}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Đã tải xuống file sao lưu JSON");
        }

        function importJSON(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed && Array.isArray(parsed.cards)) {
                        appState = parsed;
                        saveData();
                        renderAll();
                        showToast("Khôi phục dữ liệu thành công!");
                    } else {
                        showToast("File sao lưu không hợp lệ!", true);
                    }
                } catch (err) {
                    showToast("Lỗi đọc file JSON!", true);
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        function exportCSV() {
            const headers = ["Tên thẻ", "Mã thẻ", "Hệ thẻ", "Khách hàng", "Đợt gửi", "Gói PSA", "Số lượng", "Phí PSA (JPY)", "Thu khách (JPY)", "Trạng thái", "Điểm số", "Số Cert", "Ghi chú"];
            const rows = appState.cards.map(c => {
                const batchName = appState.batches.find(b => b.id === c.batchId)?.name || '';
                return [
                    c.name, c.code, c.tcg, c.customer, batchName, c.serviceTier,
                    c.qty, c.psaCost, c.customerPrice, c.status, c.grade, c.cert, c.notes
                ].map(val => `"${String(val || '').replace(/"/g, '""')}"`).join(',');
            });

            // Thêm BOM \uFEFF để Excel hiển thị chuẩn tiếng Việt có dấu
            const csvContent = "\uFEFF" + [headers.join(','), ...rows].join('\n');
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            const dateStr = new Date().toISOString().slice(0, 10);
            a.href = url;
            a.download = `PSA_Cards_${dateStr}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Đã xuất file bảng tính CSV");
        }

        // ================= XUẤT & ĐỒNG BỘ GOOGLE SHEETS ("CHẤM PSA") =================
        const STATUS_LABELS_VI = {
            preparing: 'Chuẩn bị / Soi thẻ',
            shipped: 'Đã gửi đi PSA',
            grading: 'Đang chấm tại PSA',
            graded: 'Đã có điểm / Về tay',
            returned: 'Đã trả khách'
        };

        // Chuẩn bị mảng dữ liệu chuẩn 10 cột cho Google Sheets
        function buildGoogleSheetsRows() {
            const overheadMap = getBatchOverheadPerCardMap();
            const nowStr = new Date().toLocaleString('vi-VN', {
                hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric'
            });

            const headers = [
                "Sản phẩm",
                "Số lượng",
                "Khách hàng",
                "Ngày giờ",
                "Gói chấm",
                "Giá tiền (¥)",
                "Tình trạng đơn hàng",
                "Chi phí PSA (¥)",
                "Lợi nhuận (¥)",
                "Đợt gửi"
            ];

            const rows = appState.cards.map(c => {
                const qty = Number(c.qty) || 1;
                const overhead = c.batchId ? (overheadMap[c.batchId] || 0) : 0;
                const totalCost = Math.round(((Number(c.psaCost) || 0) + overhead) * qty);
                const totalPrice = Math.round((Number(c.customerPrice) || 0) * qty);
                const isPersonal = !c.customer || c.customer.trim().toLowerCase() === 'cá nhân';
                const profit = isPersonal ? 0 : (totalPrice - totalCost);
                const batchName = appState.batches.find(b => b.id === c.batchId)?.name || 'Chưa phân đợt';
                const productDisplay = c.code ? `${c.name} (${c.code}) [${c.tcg}]` : `${c.name} [${c.tcg}]`;
                const statusDisplay = `${STATUS_LABELS_VI[c.status] || c.status} - ${c.grade || ''}${c.cert ? ' (Cert: ' + c.cert + ')' : ''}`;

                return [
                    productDisplay,
                    qty,
                    c.customer || 'Cá nhân',
                    nowStr,
                    c.serviceTier || 'Value Bulk',
                    totalPrice,
                    statusDisplay,
                    totalCost,
                    profit,
                    batchName
                ];
            });

            return [headers, ...rows];
        }

        // Cách 1: Copy định dạng TSV vào Clipboard và mở thẳng https://sheets.new
        function exportAndOpenGoogleSheets() {
            if (appState.cards.length === 0) {
                showToast("Danh sách thẻ đang trống!", true);
                return;
            }

            const rows = buildGoogleSheetsRows();
            // Chuyển thành TSV (Tab-Separated Values) để khi dán vào Google Sheets tự chia đúng từng cột
            const tsvText = rows.map(row =>
                row.map(cell => String(cell ?? '').replace(/[\t\r\n]+/g, ' ')).join('\t')
            ).join('\n');

            // Sao chép bằng textarea ẩn + document.execCommand('copy') để tương thích tốt nhất trên iOS Safari / iFrame
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = tsvText;
            tempTextArea.style.position = 'fixed';
            tempTextArea.style.left = '-9999px';
            tempTextArea.style.top = '0';
            document.body.appendChild(tempTextArea);
            tempTextArea.focus();
            tempTextArea.select();

            let copied = false;
            try {
                copied = document.execCommand('copy');
            } catch (err) {
                copied = false;
            }
            document.body.removeChild(tempTextArea);

            if (copied) {
                showToast("Đã chép bảng! Hãy chọn ô A1 và Dán (Paste)");
            } else {
                showToast("Đang mở Google Sheets...", false);
            }

            setTimeout(() => {
                window.open('https://sheets.new', '_blank');
            }, 350);
        }

        // Lưu Webhook URL
        function saveWebhookUrl(url) {
            appState.gsWebhookUrl = (url || '').trim();
            saveData();
            if (appState.gsWebhookUrl) {
                showToast("Đã lưu Google Sheets Webhook URL");
            }
        }

        // Cách 2: Gửi dữ liệu trực tiếp qua Google Apps Script Webhook
        async function pushToGoogleSheets() {
            const url = (appState.gsWebhookUrl || document.getElementById('gsWebhookInput').value || '').trim();
            if (!url) {
                showToast("Vui lòng nhập Webhook URL trước!", true);
                document.getElementById('gsWebhookInput').focus();
                return;
            }
            if (!url.startsWith('https://script.google.com/')) {
                showToast("URL phải bắt đầu bằng https://script.google.com/", true);
                return;
            }

            const btn = document.getElementById('pushGsBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Đang đẩy dữ liệu lên Sheets...`;

            try {
                const rows = buildGoogleSheetsRows();
                // Dùng mode 'no-cors' với Content-Type 'text/plain' để vượt qua giới hạn CORS của Google Apps Script trên Safari
                await fetch(url, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'text/plain;charset=utf-8'
                    },
                    body: JSON.stringify({
                        sheetName: 'Chấm PSA',
                        rows: rows
                    })
                });

                showToast(`Đã đẩy ${rows.length - 1} dòng lên Google Sheets!`);
            } catch (error) {
                console.error("Lỗi đồng bộ Google Sheets:", error);
                showToast("Không thể kết nối Webhook. Kiểm tra lại mạng hoặc URL!", true);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        // Modal xem và copy mã Google Apps Script
        function openScriptModal() {
            const modal = document.getElementById('scriptModal');
            const backdrop = modal.querySelector('.bottom-sheet-backdrop');
            const panel = document.getElementById('scriptModalPanel');

            modal.classList.remove('hidden');
            requestAnimationFrame(() => {
                backdrop.classList.remove('opacity-0');
                panel.classList.remove('translate-y-full');
            });
        }

        function closeScriptModal() {
            const modal = document.getElementById('scriptModal');
            const backdrop = modal.querySelector('.bottom-sheet-backdrop');
            const panel = document.getElementById('scriptModalPanel');

            backdrop.classList.add('opacity-0');
            panel.classList.add('translate-y-full');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function copyAppsScriptCode() {
            const codeArea = document.getElementById('appsScriptCodeArea');
            codeArea.focus();
            codeArea.select();
            codeArea.setSelectionRange(0, 99999);

            try {
                document.execCommand('copy');
                showToast("Đã sao chép mã Google Apps Script!");
            } catch (e) {
                showToast("Không thể tự sao chép, hãy giữ để copy thủ công", true);
            }
        }

        // ================= TIỆN ÍCH UI (TOAST, DIALOG, ESCAPE HTML) =================
        let toastTimeout;
        function showToast(msg, isError = false) {
            const toast = document.getElementById('toastMessage');
            const icon = toast.querySelector('i');
            document.getElementById('toastText').textContent = msg;
            
            icon.className = isError ? 'fa-solid fa-circle-exclamation text-psa-red' : 'fa-solid fa-circle-check text-ios-green';
            toast.classList.remove('opacity-0');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 2500);
        }

        let confirmCallback = null;
        function openConfirmDialog(title, body, onConfirm) {
            document.getElementById('confirmTitle').textContent = title;
            document.getElementById('confirmBody').textContent = body;
            confirmCallback = onConfirm;
            document.getElementById('confirmDialog').classList.remove('hidden');
        }

        function closeConfirmDialog() {
            document.getElementById('confirmDialog').classList.add('hidden');
            confirmCallback = null;
        }

        document.getElementById('confirmOkBtn').onclick = function () {
            if (confirmCallback) confirmCallback();
            closeConfirmDialog();
        };

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
