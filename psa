    <script>
        // Khóa lưu trữ LocalStorage
        const STORAGE_KEY = 'psa_tracker_pro_data_v1';

        // Dữ liệu mặc định ban đầu (kèm 4 thẻ mẫu thực tế)
        const DEFAULT_DATA = {
            exchangeRate: 168, // 1 JPY = 168 VND
            currencyMode: 'JPY', // 'JPY' hoặc 'VND'
            selectedBatch: 'ALL',
            gsWebhookUrl: '',
            batches: [
                {
                    id: 'batch_1',
                    name: 'Đợt 11/2026 - PSA Japan Bulk',
                    shippingFee: 2500,
                    extraFee: 1000
                },
                {
                    id: 'batch_2',
                    name: 'Đợt Express - Hàng Giá Trị Cao',
                    shippingFee: 3200,
                    extraFee: 2500
                }
            ],
            cards: [
                {
                    id: 'sample_1',
                    isSample: true,
                    name: 'Charizard VSTAR SAR',
                    code: 's12a 212/172',
                    tcg: 'Pokémon',
                    customer: 'Anh Minh (Q1)',
                    batchId: 'batch_1',
                    serviceTier: 'Value Bulk',
                    qty: 1,
                    psaCost: 2980,
                    customerPrice: 4800,
                    status: 'grading',
                    grade: 'Dự kiến 10',
                    cert: '',
                    notes: 'Mặt trước chuẩn 50/50, không chấm trắng.'
                },
                {
                    id: 'sample_2',
                    isSample: true,
                    name: 'Monkey D. Luffy (Gear 5) Manga Alt Art',
                    code: 'OP05-119 SEC',
                    tcg: 'One Piece',
                    customer: 'Cá nhân',
                    batchId: 'batch_2',
                    serviceTier: 'Express',
                    qty: 1,
                    psaCost: 22000,
                    customerPrice: 0,
                    status: 'graded',
                    grade: 'PSA 10',
                    cert: '94810274',
                    notes: 'Thẻ tự sưu tầm, đã về tay nguyên seal.'
                },
                {
                    id: 'sample_3',
                    isSample: true,
                    name: 'Pikachu with Grey Felt Hat',
                    code: 'SVP EN 085',
                    tcg: 'Pokémon',
                    customer: 'Tuấn Anh',
                    batchId: 'batch_1',
                    serviceTier: 'Value Bulk',
                    qty: 2,
                    psaCost: 2980,
                    customerPrice: 4500,
                    status: 'shipped',
                    grade: 'Dự kiến 10',
