                            <h3 class="text-sm font-bold text-gray-900">📦 ${escapeHtml(batch.name)}</h3>
                            <span class="text-xs font-bold bg-blue-50 text-ios-blue px-2.5 py-1 rounded-full">${totalQty} thẻ</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-xs bg-gray-50 p-2.5 rounded-xl">
                            <div>
                                <span class="text-gray-400 block text-[11px]">Ship + Phụ phí lô:</span>
                                <span class="font-bold text-gray-800">${formatMoney(overhead)}</span>
                                <span class="text-[10px] text-gray-400 block">(~${formatMoney(perCardOverhead)}/thẻ)</span>
                            </div>
                            <div class="text-right">
                                <span class="text-gray-400 block text-[11px]">Lợi nhuận cả lô:</span>
                                <span class="font-extrabold ${batchProfit >= 0 ? 'text-ios-green' : 'text-psa-red'}">${batchProfit >= 0 ? '+' : ''}${formatMoney(batchProfit)}</span>
                                <span class="text-[10px] text-gray-400 block">Tổng chi: ${formatMoney(totalBatchCost)}</span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

