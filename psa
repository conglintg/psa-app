        function applyTierPrice(tier) {
            const select = document.getElementById('cardServiceTier');
            const option = select.options[select.selectedIndex];
            const suggested = option.getAttribute('data-price');
            if (suggested && Number(suggested) > 0) {
                document.getElementById('cardPsaCost').value = suggested;
                updateModalProfitPreview();
            }
        }

        function updateModalProfitPreview() {
            const qty = Number(document.getElementById('cardQty').value) || 1;
            const cost = Number(document.getElementById('cardPsaCost').value) || 0;
            const rev = Number(document.getElementById('cardCustomerPrice').value) || 0;
            const profit = (rev - cost) * qty;

            const el = document.getElementById('modalProfitPreview');
            el.textContent = `Lãi gộp: ${profit >= 0 ? '+' : ''}¥${profit.toLocaleString('en-US')}`;
            el.className = `text-xs font-bold ${profit >= 0 ? 'text-ios-green' : 'text-psa-red'}`;
        }

        function saveCard() {
            const name = document.getElementById('cardName').value.trim();
            if (!name) {
                showToast("Vui lòng nhập tên thẻ!", true);
                document.getElementById('cardName').focus();
                return;
            }

            const editId = document.getElementById('editCardId').value;
            const cardObj = {
                id: editId || 'card_' + Date.now(),
                isSample: false,
                name: name,
                code: document.getElementById('cardCode').value.trim(),
                tcg: document.getElementById('cardTcg').value,
                customer: document.getElementById('cardCustomer').value.trim() || 'Cá nhân',
                batchId: document.getElementById('cardBatchId').value,
                serviceTier: document.getElementById('cardServiceTier').value,
                qty: Math.max(1, parseInt(document.getElementById('cardQty').value) || 1),
                psaCost: Math.max(0, parseFloat(document.getElementById('cardPsaCost').value) || 0),
                customerPrice: Math.max(0, parseFloat(document.getElementById('cardCustomerPrice').value) || 0),
                status: document.getElementById('cardStatus').value,
                grade: document.getElementById('cardGrade').value,
                cert: document.getElementById('cardCert').value.trim(),
                notes: document.getElementById('cardNotes').value.trim()
            };

            if (editId) {
                const idx = appState.cards.findIndex(c => c.id === editId);
                if (idx !== -1) appState.cards[idx] = cardObj;
                showToast("Đã cập nhật thông tin thẻ");
            } else {
                appState.cards.unshift(cardObj);
                showToast("Đã thêm thẻ mới");
            }

            saveData();
            closeCardModal();
            renderAll();
        }

        function deleteCurrentCard() {
            const editId = document.getElementById('editCardId').value;
            if (!editId) return;
            openConfirmDialog("Xóa thẻ này?", "Thao tác này không thể hoàn tác.", () => {
                appState.cards = appState.cards.filter(c => c.id !== editId);
                saveData();
                closeCardModal();
                renderAll();
                showToast("Đã xóa thẻ");
            });
        }

        // ================= QUẢN LÝ ĐỢT GỬI (BATCHES) =================
        function renderBatches() {
            const container = document.getElementById('batchesListContainer');
            if (appState.batches.length === 0) {
                container.innerHTML = `<div class="bg-white rounded-2xl p-6 text-center text-xs text-gray-500">Chưa có đợt gửi nào. Nhấn "+ Tạo đợt gửi" để bắt đầu.</div>`;
                return;
            }

            container.innerHTML = appState.batches.map(batch => {
                const cardsInBatch = appState.cards.filter(c => c.batchId === batch.id);
                const totalQty = cardsInBatch.reduce((s, c) => s + (Number(c.qty) || 1), 0);
                const basePsaCost = cardsInBatch.reduce((s, c) => s + (Number(c.psaCost) || 0) * (Number(c.qty) || 1), 0);
                const overhead = (Number(batch.shippingFee) || 0) + (Number(batch.extraFee) || 0);
                const totalBatchCost = basePsaCost + overhead;
                const totalBatchRev = cardsInBatch.reduce((s, c) => s + (Number(c.customerPrice) || 0) * (Number(c.qty) || 1), 0);
                const batchProfit = totalBatchRev - totalBatchCost;
                const perCardOverhead = totalQty > 0 ? Math.round(overhead / totalQty) : 0;

                return `
                    <div onclick="openBatchModal('${batch.id}')" class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-2.5 active:scale-[0.99] transition cursor-pointer">
