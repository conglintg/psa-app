                }
            ]
        };

        let appState = {};

        // Khởi tạo ứng dụng
        window.onload = function () {
            loadData();
            renderAll();
        };

        // Tải dữ liệu từ LocalStorage
        function loadData() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    appState = JSON.parse(raw);
                    // Đảm bảo cấu trúc đầy đủ
                    if (!appState.batches) appState.batches = [];
                    if (!appState.cards) appState.cards = [];
                    if (!appState.exchangeRate) appState.exchangeRate = 168;
                    if (!appState.currencyMode) appState.currencyMode = 'JPY';
                    if (typeof appState.gsWebhookUrl !== 'string') appState.gsWebhookUrl = '';
                } else {
                    appState = JSON.parse(JSON.stringify(DEFAULT_DATA));
                    saveData();
                }
            } catch (e) {
                console.error("Lỗi đọc LocalStorage:", e);
                appState = JSON.parse(JSON.stringify(DEFAULT_DATA));
            }
        }

        // Lưu dữ liệu vào LocalStorage
        function saveData() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            } catch (e) {
                showToast("Không thể lưu vào bộ nhớ trình duyệt!", true);
