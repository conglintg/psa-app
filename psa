<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <!-- Cấu hình chế độ Web App toàn màn hình trên iPhone -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="PSA Tracker">
    <meta name="theme-color" content="#F2F2F7">
    <title>PSA Tracker Pro - Quản Lý Gửi Chấm Thẻ</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ios: {
                            bg: '#F2F2F7',
                            card: '#FFFFFF',
                            separator: '#C6C6C8',
                            blue: '#007AFF',
                            red: '#FF3B30',
                            green: '#34C759',
                            orange: '#FF9500',
                            purple: '#AF52DE',
                            gray: '#8E8E93',
                            lightGray: '#E5E5EA'
                        },
                        psa: {
                            red: '#D32F2F',
                            blue: '#1565C0'
                        }
                    },
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'SF Pro Display', 'Segoe UI', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Tối ưu trải nghiệm cảm ứng chuẩn iOS */
        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }
        body {
            background-color: #F2F2F7;
            color: #1C1C1E;
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
            padding-top: env(safe-area-inset-top);
            padding-bottom: calc(85px + env(safe-area-inset-bottom));
            overscroll-behavior-y: none;
        }
        /* Ngăn iOS tự động zoom khi chạm vào ô input */
        input, select, textarea {
            font-size: 16px !important;
        }
        /* Ẩn thanh cuộn nhưng vẫn cho phép vuốt */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Hiệu ứng trượt Bottom Sheet */
        .bottom-sheet-backdrop {
            transition: opacity 0.25s ease;
        }
        .bottom-sheet-panel {
            transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
            padding-bottom: calc(20px + env(safe-area-inset-bottom));
        }
        .bottom-tab-bar {
            padding-bottom: env(safe-area-inset-bottom);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            background-color: rgba(255, 255, 255, 0.88);
        }
        .ios-header {
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            background-color: rgba(242, 242, 247, 0.85);
            padding-top: max(12px, env(safe-area-inset-top));
        }
    </style>
</head>
<body class="antialiased select-none">

    <!-- ================= HEADER CỐ ĐỊNH ================= -->
    <header class="ios-header sticky top-0 z-30 border-b border-gray-200/80 px-4 pb-3">
        <div class="max-w-lg mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-psa-red to-red-700 flex items-center justify-center text-white font-black text-xs tracking-tighter shadow-sm">
                    PSA
                </div>
                <div>
                    <h1 id="headerTitle" class="text-lg font-bold tracking-tight text-gray-900 leading-tight">Danh Sách Thẻ</h1>
                    <p id="headerSubtitle" class="text-xs text-gray-500 font-medium">Tỷ giá: 1¥ = <span id="headerRateDisplay">168</span>₫</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <!-- Nút chuyển đổi hiển thị tiền tệ nhanh -->
                <button onclick="toggleCurrencyDisplay()" id="currencyToggleBtn" class="px-3 py-1.5 rounded-full bg-white border border-gray-200 text-xs font-bold text-gray-700 shadow-sm active:scale-95 transition">
                    ¥ JPY
                </button>
                <!-- Nút thêm thẻ mới -->
                <button onclick="openCardModal()" class="w-9 h-9 rounded-full bg-ios-blue text-white flex items-center justify-center shadow-sm active:scale-95 transition" aria-label="Thêm thẻ">
                    <i class="fa-solid fa-plus text-base"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- ================= NỘI DUNG CHÍNH ================= -->
    <main class="max-w-lg mx-auto px-4 pt-3">

        <!-- ==================== TAB 1: DANH SÁCH THẺ ==================== -->
        <section id="tab-cards" class="space-y-4">
            
            <!-- Chọn Đợt Gửi (Submission Batch Selector) -->
            <div class="flex items-center gap-2">
                <div class="relative flex-1">
                    <select id="batchFilterSelect" onchange="handleBatchChange(this.value)" class="w-full appearance-none bg-white border border-gray-200/80 rounded-2xl py-2.5 pl-3.5 pr-9 font-semibold text-sm text-gray-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-ios-blue/30">
                        <option value="ALL">📦 Tất cả đợt gửi</option>
                    </select>
                    <i class="fa-solid fa-chevron-down text-xs text-gray-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                </div>
                <button onclick="switchTab('batches')" class="px-3.5 py-2.5 bg-white border border-gray-200/80 rounded-2xl text-xs font-semibold text-ios-blue shadow-sm active:scale-95 transition whitespace-nowrap">
                    + Đợt mới
                </button>
            </div>

            <!-- Dashboard Tổng Quan Tài Chính & Số Lượng -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
                <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Tổng thẻ quản lý</p>
                        <div class="flex items-baseline gap-2 mt-0.5">
                            <span id="statTotalCards" class="text-2xl font-extrabold text-gray-900">0</span>
                            <span class="text-xs font-medium text-gray-500">thẻ (<span id="statCompletedCards">0</span> xong)</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Lợi nhuận ròng dự kiến</p>
                        <p id="statNetProfit" class="text-xl font-extrabold text-ios-green mt-0.5">¥0</p>
                        <p id="statNetProfitSub" class="text-[11px] font-medium text-gray-400">0 ₫</p>
                    </div>
                </div>

                <!-- Chi phí & Doanh thu -->
                <div class="grid grid-cols-2 gap-3 pt-0.5">
                    <div class="bg-gray-50/80 rounded-xl p-2.5">
                        <div class="flex items-center gap-1.5 text-xs text-gray-500 font-medium">
                            <span class="w-2 h-2 rounded-full bg-psa-red"></span>
                            Tổng chi phí PSA
                        </div>
                        <p id="statTotalCost" class="text-sm font-bold text-gray-900 mt-1">¥0</p>
                        <p id="statTotalCostSub" class="text-[11px] text-gray-400">Gồm phí ship/lô</p>
                    </div>
                    <div class="bg-gray-50/80 rounded-xl p-2.5">
                        <div class="flex items-center gap-1.5 text-xs text-gray-500 font-medium">
                            <span class="w-2 h-2 rounded-full bg-ios-blue"></span>
                            Tổng thu từ khách
                        </div>
                        <p id="statTotalRevenue" class="text-sm font-bold text-gray-900 mt-1">¥0</p>
                        <p id="statTotalRevenueSub" class="text-[11px] text-gray-400">Chưa tính thẻ cá nhân</p>
                    </div>
                </div>

                <!-- Thống kê nhanh 4 trạng thái -->
                <div class="grid grid-cols-4 gap-1.5 pt-1 text-center">
                    <div onclick="quickFilterStatus('preparing')" class="bg-amber-50/80 rounded-xl py-2 px-1 cursor-pointer active:scale-95 transition">
                        <p id="countPreparing" class="text-sm font-bold text-amber-600">0</p>
                        <p class="text-[10px] font-medium text-amber-800/80 truncate">Chuẩn bị</p>
                    </div>
                    <div onclick="quickFilterStatus('shipped')" class="bg-blue-50/80 rounded-xl py-2 px-1 cursor-pointer active:scale-95 transition">
                        <p id="countShipped" class="text-sm font-bold text-blue-600">0</p>
                        <p class="text-[10px] font-medium text-blue-800/80 truncate">Đã gửi</p>
                    </div>
                    <div onclick="quickFilterStatus('grading')" class="bg-purple-50/80 rounded-xl py-2 px-1 cursor-pointer active:scale-95 transition">
                        <p id="countGrading" class="text-sm font-bold text-purple-600">0</p>
                        <p class="text-[10px] font-medium text-purple-800/80 truncate">Đang chấm</p>
                    </div>
                    <div onclick="quickFilterStatus('done')" class="bg-emerald-50/80 rounded-xl py-2 px-1 cursor-pointer active:scale-95 transition">
                        <p id="countDone" class="text-sm font-bold text-emerald-600">0</p>
                        <p class="text-[10px] font-medium text-emerald-800/80 truncate">Hoàn thành</p>
                    </div>
                </div>
            </div>

            <!-- Thanh Tìm Kiếm & Bộ Lọc -->
            <div class="space-y-2.5">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass text-gray-400 text-sm absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="searchInput" oninput="renderCards()" placeholder="Tìm tên thẻ, mã (s12a 212), khách hàng..." class="w-full bg-white border border-gray-200/80 rounded-2xl py-2.5 pl-10 pr-9 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-ios-blue/30">
                    <button id="clearSearchBtn" onclick="clearSearch()" class="hidden text-gray-400 hover:text-gray-600 absolute right-3 top-1/2 -translate-y-1/2 p-1">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>

                <!-- Filter Pills: Trạng thái & Hệ thẻ -->
                <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
                    <select id="statusFilterSelect" onchange="renderCards()" class="bg-white border border-gray-200/80 rounded-full px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm focus:outline-none">
                        <option value="ALL">Trạng thái: Tất cả</option>
                        <option value="preparing">🟡 Chuẩn bị / Soi thẻ</option>
                        <option value="shipped">🔵 Đã gửi đi PSA</option>
                        <option value="grading">🟣 Đang chấm tại PSA</option>
                        <option value="graded">🟢 Đã có điểm / Về tay</option>
                        <option value="returned">✅ Đã trả khách</option>
                    </select>

                    <select id="tcgFilterSelect" onchange="renderCards()" class="bg-white border border-gray-200/80 rounded-full px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-sm focus:outline-none">
                        <option value="ALL">Hệ thẻ: Tất cả</option>
                        <option value="Pokémon">Pokémon</option>
                        <option value="One Piece">One Piece</option>
                        <option value="Yu-Gi-Oh!">Yu-Gi-Oh!</option>
                        <option value="Dragon Ball">Dragon Ball</option>
                        <option value="Khác">Khác</option>
                    </select>

                    <button id="resetFilterBtn" onclick="resetFilters()" class="hidden px-3 py-1.5 rounded-full bg-red-50 text-psa-red text-xs font-semibold whitespace-nowrap">
                        Xóa lọc
                    </button>
                </div>
            </div>

            <!-- Danh sách thẻ -->
            <div id="cardsListContainer" class="space-y-3 pb-4">
                <!-- Cards được render tự động bằng JS -->
            </div>
        </section>

        <!-- ==================== TAB 2: TÍNH CHI PHÍ & LÔ GỬI ==================== -->
        <section id="tab-batches" class="hidden space-y-4 pb-6">
            
            <!-- Công cụ quy đổi tiền tệ nhanh JPY <-> VND -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-bold text-gray-900 flex items-center gap-2">
                        <i class="fa-solid fa-Calculator text-ios-blue"></i> Quy đổi nhanh JPY ⇄ VNĐ
                    </h2>
                    <div class="flex items-center gap-1.5 bg-gray-100 px-2.5 py-1 rounded-lg">
                        <span class="text-xs text-gray-500">Tỷ giá:</span>
                        <input type="number" id="exchangeRateInput" onchange="updateExchangeRate(this.value)" class="w-14 bg-transparent text-right font-bold text-xs text-gray-900 focus:outline-none" value="168">
                        <span class="text-xs text-gray-500">₫</span>
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-[11px] font-medium text-gray-500 block mb-1">Số tiền Yên Nhật (¥)</label>
                        <input type="number" id="quickJpyInput" oninput="convertQuickCurrency('JPY')" placeholder="VD: 3300" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 font-bold text-gray-900 focus:outline-none focus:border-ios-blue">
                    </div>
                    <div>
                        <label class="text-[11px] font-medium text-gray-500 block mb-1">Tiền Việt Nam (₫)</label>
                        <input type="number" id="quickVndInput" oninput="convertQuickCurrency('VND')" placeholder="VD: 554400" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 font-bold text-ios-blue focus:outline-none focus:border-ios-blue">
                    </div>
                </div>
            </div>

            <!-- Quản lý các đợt gửi (Submission Batches) -->
            <div class="flex items-center justify-between pt-1">
                <h2 class="text-base font-bold text-gray-900">Các Đợt Gửi (Batches)</h2>
                <button onclick="openBatchModal()" class="px-3.5 py-1.5 bg-ios-blue text-white rounded-full text-xs font-bold shadow-sm active:scale-95 transition">
                    + Tạo đợt gửi
                </button>
            </div>
            <p class="text-xs text-gray-500 -mt-2">Nhập phí ship, bảo hiểm, upcharge cho từng đợt để hệ thống tự động chia đều chi phí vào từng thẻ.</p>

            <div id="batchesListContainer" class="space-y-3">
                <!-- Danh sách đợt gửi render bằng JS -->
            </div>
        </section>

        <!-- ==================== TAB 3: CÀI ĐẶT & SAO LƯU ==================== -->
        <section id="tab-settings" class="hidden space-y-4 pb-6">
            
            <!-- Thống kê lưu trữ & Dữ liệu mẫu -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
                <h2 class="text-sm font-bold text-gray-900">Quản lý dữ liệu ứng dụng</h2>
                <p class="text-xs text-gray-500 leading-relaxed">
                    Toàn bộ dữ liệu được lưu trực tiếp trong bộ nhớ trình duyệt Safari trên iPhone của bạn. Hãy thường xuyên xuất file sao lưu để tránh mất dữ liệu khi xóa lịch sử trình duyệt.
                </p>

                <div class="grid grid-cols-1 gap-2.5 pt-2">
                    <button onclick="exportJSON()" class="w-full flex items-center justify-between bg-blue-50/80 hover:bg-blue-100/80 text-ios-blue font-semibold px-4 py-3 rounded-xl transition active:scale-[0.99]">
                        <span class="flex items-center gap-2.5 text-sm">
                            <i class="fa-solid fa-file-export"></i> Xuất bản sao lưu (.JSON)
                        </span>
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </button>

                    <button onclick="exportCSV()" class="w-full flex items-center justify-between bg-emerald-50/80 hover:bg-emerald-100/80 text-emerald-700 font-semibold px-4 py-3 rounded-xl transition active:scale-[0.99]">
                        <span class="flex items-center gap-2.5 text-sm">
                            <i class="fa-solid fa-file-excel"></i> Xuất bảng tính Excel / Sheets (.CSV)
                        </span>
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </button>

                    <label class="w-full flex items-center justify-between bg-gray-100 hover:bg-gray-200/80 text-gray-800 font-semibold px-4 py-3 rounded-xl transition cursor-pointer active:scale-[0.99]">
                        <span class="flex items-center gap-2.5 text-sm">
                            <i class="fa-solid fa-file-import"></i> Khôi phục từ file (.JSON)
                        </span>
                        <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                        <input type="file" id="importJsonInput" accept=".json" onchange="importJSON(event)" class="hidden">
                    </label>
                </div>
            </div>

            <!-- Xuất & Đồng Bộ Google Sheets ("Chấm PSA") -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-bold text-gray-900 flex items-center gap-2">
                        <i class="fa-solid fa-table text-emerald-600"></i> Xuất ra Google Sheets
                    </h2>
                    <span class="text-[11px] font-semibold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full">2 Cách</span>
                </div>

                <!-- Cách 1: Copy TSV & Mở sheets.new -->
                <div class="bg-emerald-50/60 border border-emerald-100 rounded-xl p-3 space-y-2">
                    <p class="text-xs font-bold text-emerald-900">Cách 1: Dán nhanh 1 chạm (Không cần cài đặt)</p>
                    <p class="text-[11px] text-emerald-800/80 leading-relaxed">
                        Tự động sao chép toàn bộ bảng thẻ và mở trang tạo Google Sheet mới. Bạn chỉ cần chạm vào ô <strong>A1</strong> và chọn <strong>Dán (Paste)</strong> là tự chia đúng từng cột.
                    </p>
                    <button onclick="exportAndOpenGoogleSheets()" class="w-full py-2.5 px-3 bg-emerald-600 text-white font-bold rounded-xl text-xs shadow-sm flex items-center justify-center gap-2 active:scale-[0.99] transition">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Xuất & Mở Google Sheets
                    </button>
                </div>

                <!-- Cách 2: Đồng bộ tự động qua Apps Script Webhook -->
                <div class="bg-gray-50 border border-gray-200/80 rounded-xl p-3 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <p class="text-xs font-bold text-gray-800">Cách 2: Đồng bộ tự động (Webhook)</p>
                        <button onclick="openScriptModal()" class="text-[11px] font-bold text-ios-blue underline">
                            Xem mã Apps Script mẫu
                        </button>
                    </div>
                    <p class="text-[11px] text-gray-500 leading-relaxed">
                        Dán đường link Web App từ file Google Sheet <strong>"Chấm PSA"</strong> của bạn để đẩy dữ liệu thẳng lên bảng tính chỉ bằng 1 chạm.
                    </p>
                    <div class="space-y-2">
                        <input type="url" id="gsWebhookInput" onchange="saveWebhookUrl(this.value)" placeholder="https://script.google.com/macros/s/.../exec" class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-xs text-gray-800 focus:outline-none focus:border-ios-blue">
                        <button id="pushGsBtn" onclick="pushToGoogleSheets()" class="w-full py-2.5 px-3 bg-ios-blue text-white font-bold rounded-xl text-xs shadow-sm flex items-center justify-center gap-2 active:scale-[0.99] transition">
                            <i class="fa-solid fa-cloud-arrow-up"></i> Đẩy dữ liệu lên Google Sheets
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dữ liệu mẫu & Reset -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
                <h2 class="text-sm font-bold text-gray-900">Dữ liệu mẫu & Đặt lại</h2>
                <div class="space-y-2.5">
                    <button onclick="removeSampleData()" class="w-full flex items-center justify-between bg-amber-50 text-amber-700 font-semibold px-4 py-3 rounded-xl text-sm active:scale-[0.99] transition">
                        <span><i class="fa-solid fa-broom mr-2"></i> Xóa các thẻ dữ liệu mẫu</span>
                        <span id="sampleCountBadge" class="text-xs bg-amber-200/70 px-2 py-0.5 rounded-full">0 mẫu</span>
                    </button>

                    <button onclick="confirmResetAll()" class="w-full flex items-center justify-between bg-red-50 text-psa-red font-semibold px-4 py-3 rounded-xl text-sm active:scale-[0.99] transition">
                        <span><i class="fa-solid fa-trash-can mr-2"></i> Xóa toàn bộ dữ liệu ứng dụng</span>
                        <i class="fa-solid fa-triangle-exclamation text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Hướng dẫn cài đặt lên màn hình chính iPhone -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-2">
                <h2 class="text-sm font-bold text-gray-900 flex items-center gap-2">
                    <i class="fa-brands fa-apple text-lg"></i> Mẹo dùng như App độc lập trên iPhone
                </h2>
                <ol class="text-xs text-gray-600 space-y-1.5 list-decimal pl-4 leading-relaxed">
                    <li>Mở trang web này bằng trình duyệt <strong>Safari</strong> trên iPhone.</li>
                    <li>Chạm vào biểu tượng <strong>Chia sẻ (Share)</strong> ở thanh dưới cùng.</li>
                    <li>Chọn <strong>Thêm vào MH chính (Add to Home Screen)</strong>.</li>
                    <li>Mở ứng dụng từ màn hình chính để trải nghiệm toàn màn hình không thanh địa chỉ.</li>
                </ol>
            </div>
        </section>

    </main>

    <!-- ================= THANH ĐIỀU HƯỚNG DƯỚI CÙNG (BOTTOM TAB BAR) ================= -->
    <nav class="bottom-tab-bar fixed bottom-0 left-0 right-0 z-30 border-t border-gray-200/90">
        <div class="max-w-lg mx-auto grid grid-cols-3 h-16">
            <button onclick="switchTab('cards')" id="nav-cards" class="flex flex-col items-center justify-center gap-1 text-ios-blue transition">
                <i class="fa-solid fa-layer-group text-lg"></i>
                <span class="text-[10px] font-semibold">Danh sách thẻ</span>
            </button>
